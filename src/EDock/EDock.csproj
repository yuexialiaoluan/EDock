<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.26100.56</WindowsSdkPackageVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>EDock</RootNamespace>
    <AssemblyName>EDock</AssemblyName>
    <Product>EDock</Product>
    <Title>EDock</Title>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/EDock.ico</ApplicationIcon>
    <Version>0.16.19</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>EDock · Windows 11 左右自动隐藏快捷启动栏</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Precompile managed startup paths rather than JIT them at every launch.
         Keep the self-contained directory layout: single-file extraction would
         add disk work to the first launch after an update. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\EDock.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\EDock.Taskbar.0.14.5.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\EDock.StartMenu.0.16.15.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\EDock.StartButton.0.16.18.1.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\NativeThirdPartyNotices.txt" Link="NativeThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Windows App SDK 1.8 supports individual components. Keep the exact
         WinUI/text versions supplied by 1.8.260921001 without pulling in the
         unused AI, machine-learning and Widgets runtimes. Their dependencies
         still generate the complete self-contained runtime and manifest. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="1.8.25122902" />
    <!-- The optional framework-dependent/lite build still needs an explicit
         shared Windows App Runtime dependency and bootstrap initializer. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260921001" Condition="'$(WindowsAppSDKSelfContained)' != 'true'" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>
  <!-- Unpackaged WinUI generates these after normal Content discovery. Include
       the merged resource index and compiled XAML in dotnet publish explicitly. -->
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="Publish">
    <Error Condition="!Exists('$(TargetDir)$(TargetName).pri')" Text="The WinUI resource index is missing from the build output." />
    <Error Condition="!Exists('$(TargetDir)App.xbf')" Text="The compiled WinUI application XAML is missing from the build output." />
    <ItemGroup>
      <_WinUICompiledXaml Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUICompiledXaml)" DestinationFiles="@(_WinUICompiledXaml->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\EDock.ico" DestinationFolder="$(PublishDir)Assets" SkipUnchangedFiles="true" />
  </Target>
</Project>
